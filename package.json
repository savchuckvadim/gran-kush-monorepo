{
  "name": "gran-kush",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "format:api": "turbo format --filter=api",
    "docker:dev": "docker compose --env-file apps/api/.env -f infra/compose/docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose --env-file apps/api/.env -f infra/compose/docker-compose.dev.yml down",
    "docker:prod": "docker compose --env-file infra/compose/.env -f infra/compose/docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose --env-file infra/compose/.env -f infra/compose/docker-compose.prod.yml down"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "cross-env": "^7.0.3",
    "prettier": "^3.8.1",
    "prettier-plugin-prisma": "^5.0.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "turbo": "^2.8.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.5",
      "source-map-js": ">=1.2.2",
      "proxy-addr": ">=2.0.8",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "picomatch@2": ">=2.3.2",
      "picomatch@4": ">=4.0.4",
      "fast-uri": ">=3.1.7",
      "js-yaml@4": ">=4.3.2 <5",
      "ws@8": ">=8.21.0",
      "lodash": ">=4.18.0",
      "browserslist": ">=4.28.7"
    }
  }
}
