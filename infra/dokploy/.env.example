# PafPaf on Dokploy: paste into project pafpaf → Compose → Environment and fill in.
# Real values live only in Dokploy, never in git. Generate secrets: openssl rand -hex 32
# Variables marked (required) stop the deploy with a clear error while empty.

# ── Stack ──
# (required) crm., club., api. and admin. hang off it
DOMAIN=paf-paf.app
# Image tag from ghcr.io. Roll back with TAG=sha-<full commit hash>
TAG=latest
# Empty: no member cabinet (club.). Set to club to start it as well.
COMPOSE_PROFILES=

# ── Postgres ──
# Letters and digits only: the values go into connection URLs.
# (required)
POSTGRES_USER=pafpaf
# (required)
POSTGRES_PASSWORD=
# (required) the API's database; the site creates its own "site" next to it
POSTGRES_DB=pafpaf

# ── API ──
# (required)
COOKIE_SECRET=
# (required)
JWT_SECRET=
# (required)
JWT_REFRESH_SECRET=
# (required) platform admin sessions (admin.)
PLATFORM_JWT_SECRET=
# (required) 64 hex characters: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=
# true for the first deploy only: creates the platform admin below, then set back to false
RUN_SEED=false
PLATFORM_BOOTSTRAP_ADMIN_EMAIL=
PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=
# EU provider only, e.g. email-smtp.eu-north-1.amazonaws.com (README.md → «Почта»)
MAIL_HOST=
# Hetzner blocks outgoing ports 25 and 465
MAIL_PORT=587
MAIL_LOGIN=
MAIL_PASSWORD=
# Address only, e.g. no-reply@paf-paf.app: the API adds the name from SMTP_FROM_NAME (PafPaf)
SMTP_FROM=
# Google sign-in (README.md → «Вход через Google»); empty = the button returns «not configured»
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Platform chat: club registrations and disk alerts from pafpaf-janitor (README.md → «Telegram»)
TG_BOT_API_KEY=
TG_BOT_CHAT_ID=
# Member-facing bot: Telegram sign-in and direct messages; no chat id (it writes to each member)
TG_CLIENT_BOT_API_KEY=
# имя бота кабинета без @ (вход через Telegram); у бота в @BotFather /setdomain → club.<домен>
TG_CLIENT_BOT_USERNAME=
# pafpaf-janitor: disk usage that triggers an extra cleanup and an alert (50–99)
JANITOR_DISK_ALERT_PERCENT=85
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# ── Site (Payload) ──
# (required)
PAYLOAD_SECRET=
# First start of an empty database: the CMS admin is created from these two,
# so paf-paf.app/admin never shows the open "create first user" form.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
# First start of an empty database: starter pages, plans and footer in es/ru/en
PAYLOAD_SEED_IF_EMPTY=true
