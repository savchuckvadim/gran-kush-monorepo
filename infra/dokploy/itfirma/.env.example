# IT-firma studio site (infra/dokploy/itfirma/docker-compose.yml): paste into Dokploy → Environment.

# Image tag: latest, or sha-<commit> to roll back
TAG=latest

# Contact requests by e-mail (SMTP). Port 587 with STARTTLS: the server blocks 25 and 465.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Where requests go
LEAD_TO=

# Contact requests in Telegram: a bot token and the chat that receives them
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
