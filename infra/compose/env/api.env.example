# Runtime env for the API container (docker-compose.prod.yml `env_file`).
#   cp infra/compose/env/api.env.example infra/compose/env/api.env
#
# NOTE: DATABASE_URL, REDIS_URL, NODE_ENV and PORT are set by the compose file
# (they point at the postgres/redis services) and override anything here.

APP_NAME="Gran Kush API"
APP_DESCRIPTION="Gran Kush API"

# ── URLs / CORS ──
# CORS_ORIGIN is an exact-match list — scheme and port included, no wildcards
# (the frontends send credentials: "include").
CORS_ORIGIN=https://crm.nagual.club,https://nagual.club,https://admin.nagual.club
CRM_FRONTEND_URL=https://crm.nagual.club
MEMBER_FRONTEND_URL=https://nagual.club

# ── Cookies ──
# Leading dot shares the cookie across api./crm./... subdomains.
# Read via getOrThrow: the API refuses to start if these are unset.
CRM_AUTH_COOKIE_DOMAIN=.nagual.club
MEMBER_AUTH_COOKIE_DOMAIN=.nagual.club
MEMBER_ACCESS_COOKIE_NAME=member_access_token
MEMBER_REFRESH_COOKIE_NAME=member_refresh_token
CRM_ACCESS_COOKIE_NAME=crm_access_token
CRM_REFRESH_COOKIE_NAME=crm_refresh_token
AUTH_COOKIE_SECURE=true
COOKIE_SECRET=change-me-cookie-secret

# ── JWT ──
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=1d
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ── Encryption ──
ENCRYPTION_MASTER_KEY=change-me-64-hex-chars

# ── Telegram notifications ──
TG_BOT_API_KEY=
TG_BOT_CHAT_ID=

# ── Mail (SMTP) ──
MAIL_HOST=smtp.beget.com
MAIL_PORT=25
MAIL_LOGIN=
MAIL_PASSWORD=

# ── Platform bootstrap admin (seeded when RUN_SEED=true) ──
PLATFORM_BOOTSTRAP_ADMIN_EMAIL=admin@nagual.club
PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=change-me
PLATFORM_BOOTSTRAP_ADMIN_NAME=ADMIN
PLATFORM_BOOTSTRAP_ADMIN_ENABLED=true
PLATFORM_BOOTSTRAP_NEED_ADMIN_SEED=true

# ── AWS S3 (private/public file storage) ──
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=clubs-crm
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# ── Set by compose — do not edit here ──
# DATABASE_URL=postgresql://user:pass@postgres:5432/bro-crm?schema=public
# REDIS_URL=redis://redis:6379
