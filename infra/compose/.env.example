# Interpolated into docker-compose.prod.yml.
#   cp infra/compose/.env.example infra/compose/.env
# Then pass it explicitly:
#   docker compose --env-file infra/compose/.env -f infra/compose/docker-compose.prod.yml up -d --build

# ── Postgres (used to build DATABASE_URL for the api service) ──
POSTGRES_USER=kush
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bro-crm

# ── Public URLs inlined into the frontend bundles (must be browser-reachable) ──
# Build-time, not runtime: change these → rebuild the crm/web/admin images.
NEXT_PUBLIC_API_URL=https://api.nagual.club
NEXT_PUBLIC_CRM_URL=https://crm.nagual.club

# ── Domains routed by nginx ──
# Keep every host on the same registrable domain, otherwise auth cookies stop
# working across apps (see documentation/DEPLOYMENT.md §6).
API_HOST=api.nagual.club
CRM_HOST=crm.nagual.club
WEB_HOST=nagual.club
ADMIN_HOST=admin.nagual.club

# ── API startup toggles ──
# Run `prisma migrate deploy` before the API starts.
RUN_MIGRATIONS=true
# Seed the platform bootstrap admin on start (see env/api.env PLATFORM_BOOTSTRAP_*).
RUN_SEED=false
