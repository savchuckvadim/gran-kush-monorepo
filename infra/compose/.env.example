# Interpolated into docker-compose.prod.yml.
#   cp infra/compose/.env.example infra/compose/.env
# Then pass it explicitly:
#   docker compose --env-file infra/compose/.env -f infra/compose/docker-compose.prod.yml up -d --build

# ── Postgres (used to build DATABASE_URL for the api service) ──
POSTGRES_USER=kush
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bro-crm

# ── Public URLs inlined into the frontend bundles (must be browser-reachable) ──
NEXT_PUBLIC_API_URL=https://api.el-gran-kush.ru
NEXT_PUBLIC_CRM_URL=https://crm.el-gran-kush.ru

# ── Domains routed by nginx ──
API_HOST=api.el-gran-kush.ru
CRM_HOST=crm.el-gran-kush.ru
WEB_HOST=el-gran-kush.ru
ADMIN_HOST=admin.el-gran-kush.ru

# ── API startup toggles ──
# Run `prisma migrate deploy` before the API starts.
RUN_MIGRATIONS=true
# Seed the platform bootstrap admin on start (see env/api.env PLATFORM_BOOTSTRAP_*).
RUN_SEED=false
