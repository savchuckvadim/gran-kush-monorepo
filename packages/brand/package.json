{
    "name": "@workspace/brand",
    "version": "0.0.0",
    "private": true,
    "description": "Installation brands (PafPaf, Ink Space, Plis Plas): name, portal type, modules, skin, mark and domains",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./installations.json": "./src/installations.json"
    },
    "files": ["dist", "src/installations.json"],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "postinstall": "tsc -p tsconfig.json",
        "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
        "check-types": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "test": "vitest run"
    },
    "devDependencies": {
        "@workspace/eslint-config": "workspace:*",
        "@workspace/prettier-config": "workspace:*",
        "@workspace/typescript-config": "workspace:*",
        "eslint": "^9.39.2",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "vitest": "3.2.4"
    }
}
