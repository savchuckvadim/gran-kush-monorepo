# Product sites (PafPaf / Nagual). Copy to .env for local development.

# Which site this build serves: pafpaf | nagual
NEXT_PUBLIC_SITE=pafpaf
NEXT_PUBLIC_SERVER_URL=http://localhost:5002
NEXT_PUBLIC_CRM_URL=http://localhost:5000
NEXT_PUBLIC_MEMBER_URL=http://localhost:5001

# Own database next to the API's one, in the dev Postgres (infra/compose/docker-compose.dev.yml).
# `pnpm --filter site db:ensure` creates it.
DATABASE_URL=postgres://kush:kush@localhost:5432/site
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Dev: Payload syncs the schema by itself. Production: migrations (leave unset or false).
PAYLOAD_DB_PUSH=true

# Billing API for real plan prices. Empty or unreachable: the fallback prices from the CMS are shown.
BILLING_API_URL=http://localhost:3000

# Production first start (infra/dokploy): the CMS admin from env and starter content,
# only while the database is empty. Optional in dev, where `pnpm --filter site seed` does the same.
# PAYLOAD_ADMIN_EMAIL=
# PAYLOAD_ADMIN_PASSWORD=
# PAYLOAD_SEED_IF_EMPTY=true
