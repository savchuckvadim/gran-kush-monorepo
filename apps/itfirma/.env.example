# IT-firma studio site. Copy to .env for local development.

NEXT_PUBLIC_SERVER_URL=http://localhost:5003

# Where a request from the contact form goes. At least one channel must be configured,
# otherwise the form answers 503 and tells the visitor to write by e-mail.

# E-mail (SMTP), the same account the API uses
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
LEAD_TO=

# Telegram: a bot token and the chat (your own id or a group) that receives the requests
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
