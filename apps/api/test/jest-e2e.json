{
    "moduleFileExtensions": ["js", "json", "ts", "tsx"],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".e2e-spec.ts$",
    "transform": {
        "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "moduleNameMapper": {
        "^@portals$": "<rootDir>/../src/modules/portal/crm/portals",
        "^@portals/(.*)$": "<rootDir>/../src/modules/portal/crm/portals/$1",
        "^@modules$": "<rootDir>/../src/modules",
        "^@modules/(.*)$": "<rootDir>/../src/modules/$1",
        "^@shared/(.*)$": "<rootDir>/../src/modules/shared/$1",
        "^@common/(.*)$": "<rootDir>/../src/common/$1",
        "^@users$": "<rootDir>/../src/modules/users",
        "^@users/(.*)$": "<rootDir>/../src/modules/users/$1",
        "^@auth$": "<rootDir>/../src/modules/portal/auth",
        "^@auth/(.*)$": "<rootDir>/../src/modules/portal/auth/$1",
        "^@employees$": "<rootDir>/../src/modules/portal/crm/employees",
        "^@employees/(.*)$": "<rootDir>/../src/modules/portal/crm/employees/$1",
        "^@members$": "<rootDir>/../src/modules/portal/crm/members",
        "^@members/(.*)$": "<rootDir>/../src/modules/portal/crm/members/$1",
        "^@storage$": "<rootDir>/../src/modules/storage",
        "^@storage/(.*)$": "<rootDir>/../src/modules/storage/$1",
        "^@encryption$": "<rootDir>/../src/modules/encryption",
        "^@encryption/(.*)$": "<rootDir>/../src/modules/encryption/$1",
        "^@catalog$": "<rootDir>/../src/modules/portal/crm/catalog",
        "^@catalog/(.*)$": "<rootDir>/../src/modules/portal/crm/catalog/$1",
        "^@orders$": "<rootDir>/../src/modules/portal/crm/orders",
        "^@orders/(.*)$": "<rootDir>/../src/modules/portal/crm/orders/$1",
        "^@finance$": "<rootDir>/../src/modules/portal/crm/finance",
        "^@finance/(.*)$": "<rootDir>/../src/modules/portal/crm/finance/$1",
        "^@qr-codes$": "<rootDir>/../src/modules/portal/crm/qr-codes",
        "^@qr-codes/(.*)$": "<rootDir>/../src/modules/portal/crm/qr-codes/$1",
        "^@presence$": "<rootDir>/../src/modules/portal/crm/presence",
        "^@presence/(.*)$": "<rootDir>/../src/modules/portal/crm/presence/$1",
        "^@mail$": "<rootDir>/../src/modules/mail",
        "^@mail/(.*)$": "<rootDir>/../src/modules/mail/$1",
        "^@entity-fields$": "<rootDir>/../src/modules/portal/crm/entity-fields",
        "^@entity-fields/(.*)$": "<rootDir>/../src/modules/portal/crm/entity-fields/$1",
        "^@core/(.*)$": "<rootDir>/../src/core/$1",
        "^@platform/(.*)$": "<rootDir>/../src/modules/platform/$1",
        "^@crm$": "<rootDir>/../src/modules/crm/crm.module"
    }
}
