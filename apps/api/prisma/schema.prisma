// Prisma schema — entity-first multi-portal platform.
// Core idea: User is a global account; Member/Employee are per-portal bridges
// to EntityRecord (EAV). Profile attributes live in FieldValue, operational
// columns stay on bridge tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================
// Enums
// ========================

enum PortalStatus {
  active
  suspended
  archived
}

enum PortalTypeEnum {
  CLUB          @map("club")
  TATTOO_STUDIO @map("tattoo_studio")
  BEAUTY_STUDIO @map("beauty_studio")
}

enum UserAccountStatus {
  active
  pending_claim
  blocked
}

enum IdentityProvider {
  google
  telegram
}

/// Внешний вход: провайдер подтвердил, кто пришёл. `providerUserId` — стабильный id у провайдера
/// (Google `sub`, числовой id Telegram); email и имя меняются, id — нет.
///
/// Google отдаёт подтверждённый email, поэтому вход им доказывает владение адресом.
/// Telegram email не отдаёт: его identity только привязывается к уже существующему аккаунту
/// (из кабинета) и сама аккаунт не создаёт и ничего не клеймит.
/// Имя, фамилия и язык нужны, чтобы предзаполнить регистрацию клуба или анкету; аватар не храним.
model UserIdentity {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  provider       IdentityProvider
  providerUserId String           @map("provider_user_id") @db.VarChar(255)
  email          String?          @db.VarChar(255)
  /// Провайдер подтвердил этот email (Google `email_verified`); у Telegram email нет.
  emailVerified  Boolean          @default(false) @map("email_verified")
  displayName    String?          @map("display_name") @db.VarChar(255)
  givenName      String?          @map("given_name") @db.VarChar(255)
  familyName     String?          @map("family_name") @db.VarChar(255)
  /// Публичное имя в Telegram (@username); может меняться или отсутствовать.
  username       String?          @db.VarChar(255)
  locale         String?          @db.VarChar(16)
  lastLoginAt    DateTime?        @map("last_login_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("user_identities")
}

/// Приложение, в которое вошли: у каждой аудитории свои сессии и куки (AUTH_ARCHITECTURE §3).
/// `platform` — админка платформы: токены в теле ответа, их держит сервер админки
enum SessionAudience {
  crm
  cabinet
  platform
}

/// Чем вошли — для списка устройств и разбора инцидентов
enum SignInMethod {
  password
  google
  telegram
  email_link
  invitation
  registration
}

enum SessionRevokeReason {
  logout
  sign_out_everywhere
  revoked_by_user
  password_changed
  password_reset
  account_claimed
  reuse_detected
  blocked
}

/// Зачем выдана ссылка из письма (AUTH_ARCHITECTURE §6).
enum AuthTokenPurpose {
  email_verification
  password_reset
  account_setup
  /// Шаг «укажите почту» после входа через провайдера без подтверждённого адреса (Telegram)
  identity_email_link
}

enum MemberJoinSource {
  self
  registration_link
  kiosk
  crm
}

/// Согласие владельца аккаунта на членство, которое завёл клуб (TASK-663)
enum MemberConsentStatus {
  confirmed
  pending
}

/// Как человек попадает в клуб без сотрудника: только по ссылке клуба или заявкой, которую клуб одобряет
enum ClubJoinPolicy {
  link_only
  approval
}

enum UserDocumentSide {
  front
  back
  single
}

enum PortalFieldType {
  string
  text
  int
  decimal
  boolean
  date
  datetime
  single_select
  multi_select
  email
  phone
  url
  file
  signature
  document
  relation
}

enum FormPurpose {
  public_registration
  crm_create
  crm_detail
  member_cabinet
}

enum StageSemantic {
  NEW
  IN_PROGRESS
  SUCCESS
  FAILURE
}

enum RegistrationLinkKind {
  public_link
  kiosk
  /// Одноразовая ссылка для одного человека, с предзаполненной анкетой
  personal
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  expired
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

// ========================
// Portal (tenant)
// ========================

model Portal {
  id                    String         @id @default(uuid())
  name                  String         @unique @db.VarChar(40)
  displayName           String         @map("display_name") @db.VarChar(255)
  status                PortalStatus   @default(active)
  type                  PortalTypeEnum @default(CLUB) @map("type")
  publicDescription     String?        @map("public_description") @db.Text
  coverImageUrl         String?        @map("cover_image_url") @db.VarChar(500)
  address               String?        @db.VarChar(500)
  city                  String?        @db.VarChar(120)
  country               String?        @db.VarChar(120)
  latitude              Decimal?       @db.Decimal(9, 6)
  longitude             Decimal?       @db.Decimal(9, 6)
  isListedOnMap         Boolean        @default(false) @map("is_listed_on_map")
  /// Тема клуба по умолчанию (id темы CRM); личный выбор человека поверх неё. Пусто — тема PafPaf
  defaultSkin           String?        @map("default_skin") @db.VarChar(40)
  // Términos + Contrato de encargo accepted at sign-up; version = LEGAL_TERMS_VERSION
  termsAcceptedAt       DateTime?      @map("terms_accepted_at")
  termsVersion          String?        @map("terms_version") @db.VarChar(32)
  termsAcceptedByUserId String?        @map("terms_accepted_by_user_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  termsAcceptedBy       User?                  @relation("PortalTermsAcceptedBy", fields: [termsAcceptedByUserId], references: [id], onDelete: SetNull)
  members               Member[]
  employees             Employee[]
  roles                 PortalRole[]
  entityDefinitions     EntityDefinition[]
  entityRecords         EntityRecord[]
  fieldValues           FieldValue[]
  formDefinitions       FormDefinition[]
  stageCategories       StageCategory[]
  statusSets            StatusSet[]
  recordRelations       RecordRelation[]
  subscription          PortalSubscription?
  payments              Payment[]
  productCategories     ProductCategory[]
  measurementUnits      MeasurementUnit[]
  products              Product[]
  orders                Order[]
  financialTransactions FinancialTransaction[]
  registrationLinks     RegistrationLink[]
  employeeInvitations   EmployeeInvitation[]
  portalReviews         PortalReview[]
  productReviews        ProductReview[]
  uiSettings            UiSetting[]
  policy                ClubPolicy?
  presenceSettings      PresenceSettings?
  domainEvents          DomainEvent[]
  modules               PortalModule[]
  dataKeys              PortalDataKey[]
  organizationProfile   OrganizationProfile?
  taxRates              TaxRate[]
  comments              EntityComment[]
  notifications         Notification[]
  financeCategories     FinanceCategory[]
  counterparties        Counterparty[]
  ledgerEntries         LedgerEntry[]
  financePeriods        FinancePeriod[]
  stockMoves            StockMove[]
  purchases             Purchase[]

  @@index([name])
  @@index([status])
  @@index([isListedOnMap])
  @@map("portals")
}

/// Правила клуба для участников: вступление, каталог, заказы. Строки нет — действуют значения по умолчанию.
model ClubPolicy {
  portalId                 String         @id @map("portal_id")
  joinPolicy               ClubJoinPolicy @default(link_only) @map("join_policy")
  /// Каталог и заказ из кабинета, когда участник не в клубе (нет открытого визита)
  catalogOutsideClub       Boolean        @default(false) @map("catalog_outside_club")
  /// Заказ из кабинета только у одобренного участника (статус approved)
  ordersRequireApproval    Boolean        @default(false) @map("orders_require_approval")
  /// Сотрудник может оформить заказ на свою же запись участника
  staffSelfOrders          Boolean        @default(false) @map("staff_self_orders")
  /// Лимит отпуска за 30 дней включён: участнику можно задать лимит в граммах
  monthlyLimitEnabled      Boolean        @default(false) @map("monthly_limit_enabled")
  /// Лимит по умолчанию для участников без личного; пусто — без лимита
  defaultMonthlyLimitGrams Decimal?       @map("default_monthly_limit_grams") @db.Decimal(10, 3)
  updatedAt                DateTime       @updatedAt @map("updated_at")

  portal Portal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@map("club_policies")
}

// ========================
// Identity (global account)
// ========================

model User {
  id             String            @id @default(uuid())
  email          String            @unique @db.VarChar(255)
  passwordHash   String?           @map("password_hash") @db.VarChar(255)
  status         UserAccountStatus @default(active)
  displayName    String?           @map("display_name") @db.VarChar(255)
  isActive       Boolean           @default(false) @map("is_active")
  emailConfirmed Boolean           @default(false) @map("email_confirmed")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  members                 Member[]
  employees               Employee[]
  platformAdmin           PlatformAdmin?
  sessions                AuthSession[]
  authTokens              AuthToken[]
  documents               UserDocument[]
  signature               UserSignature?
  profile                 AccountProfile?
  identities              UserIdentity[]
  notificationPreferences NotificationPreference[]
  documentAccessLogs      DocumentAccessLog[]
  portalReviews           PortalReview[]
  productReviews          ProductReview[]
  termsAcceptedPortals    Portal[]                 @relation("PortalTermsAcceptedBy")

  @@index([email])
  @@index([status])
  @@index([isActive])
  @@map("users")
}

/// Документ аккаунта. Текущий — версия с наибольшим номером в паре (type, side). Новая версия
/// появляется, только если прежнюю уже показали какому-то клубу: клуб видит ровно тот файл,
/// который ему показали, и чужая загрузка его не подменяет.
/// number хранится зашифрованным (префикс enc1:, AES-256-GCM).
model UserDocument {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  type        String           @db.VarChar(50)
  side        UserDocumentSide @default(single)
  version     Int              @default(1)
  number      String?          @db.VarChar(400)
  meta        Json?
  storagePath String           @map("storage_path") @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares MemberDocumentShare[]

  @@unique([userId, type, side, version])
  @@index([userId])
  @@index([type])
  @@map("user_documents")
}

enum DocumentAccessAction {
  view
  upload
  replace
  share
  revoke
  delete
}

enum DocumentAccessActor {
  owner
  club
  system
}

/// Журнал обращений к документам и подписи аккаунта: кто, что и когда сделал. Без внешних ключей
/// на документ, клуб и сотрудника: запись переживает их удаление, это след для разбора инцидентов.
model DocumentAccessLog {
  id         String               @id @default(uuid())
  /// Чей аккаунт; при удалении аккаунта журнал уходит вместе с ним
  userId     String               @map("user_id")
  /// document | signature
  subject    String               @db.VarChar(20)
  documentId String?              @map("document_id")
  /// Членство и клуб, через которые произошло действие (для owner — клуб, которому показали)
  memberId   String?              @map("member_id")
  portalId   String?              @map("portal_id")
  actorType  DocumentAccessActor  @map("actor_type")
  /// Сотрудник клуба (Employee.id) или аккаунт-владелец (User.id)
  actorId    String?              @map("actor_id")
  action     DocumentAccessAction
  createdAt  DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([documentId])
  @@index([portalId, createdAt])
  @@map("document_access_logs")
}

/// Документ аккаунта показан этому членству (клубу). Без строки клуб документ не видит.
model MemberDocumentShare {
  id             String   @id @default(uuid())
  memberId       String   @map("member_id")
  userDocumentId String   @map("user_document_id")
  createdAt      DateTime @default(now()) @map("created_at")

  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  document UserDocument @relation(fields: [userDocumentId], references: [id], onDelete: Cascade)

  @@unique([memberId, userDocumentId])
  @@index([userDocumentId])
  @@map("member_document_shares")
}

/// Профиль аккаунта (решение 11): данные человека для предзаполнения анкет клубов. Запись клуба
/// остаётся своей — изменения профиля в клубы сами не уходят
model AccountProfile {
  userId    String    @id @map("user_id")
  firstName String?   @map("first_name") @db.VarChar(120)
  lastName  String?   @map("last_name") @db.VarChar(120)
  birthday  DateTime? @db.Date
  phone     String?   @db.VarChar(40)
  address   String?   @db.VarChar(500)
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_profiles")
}

model UserSignature {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  storagePath String   @map("storage_path") @db.VarChar(500)
  signedAt    DateTime @default(now()) @map("signed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_signatures")
}

model PlatformAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  role      String   @default("superadmin") @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_admins")
}

/// Вход аккаунта в одну аудиторию на одном устройстве (AUTH_ARCHITECTURE §3). Access-токен несёт id
/// сессии, и гвард проверяет её на каждый запрос: отзыв действует сразу. В БД — только SHA-256 токенов;
/// прежний хеш после ротации нужен, чтобы отличить гонку двух вкладок от повтора украденного токена.
model AuthSession {
  id                String               @id @default(uuid())
  userId            String               @map("user_id")
  audience          SessionAudience
  deviceId          String               @map("device_id") @db.VarChar(128)
  refreshTokenHash  String               @unique @map("refresh_token_hash") @db.VarChar(64)
  previousTokenHash String?              @map("previous_token_hash") @db.VarChar(64)
  rotatedAt         DateTime?            @map("rotated_at")
  signInMethod      SignInMethod         @map("sign_in_method")
  userAgent         String?              @map("user_agent") @db.VarChar(512)
  ipAddress         String?              @map("ip_address") @db.VarChar(64)
  createdAt         DateTime             @default(now()) @map("created_at")
  lastUsedAt        DateTime             @default(now()) @map("last_used_at")
  expiresAt         DateTime             @map("expires_at")
  revokedAt         DateTime?            @map("revoked_at")
  revokeReason      SessionRevokeReason? @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, audience, deviceId])
  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Одноразовая ссылка из письма. В БД — только SHA-256 токена; ссылка гасится при первом
/// использовании (`consumedAt`), новая ссылка того же назначения гасит прежние. `userId` пуст,
/// когда аккаунта ещё нет (ссылка на новый адрес после входа через Telegram) — тогда есть `email`.
model AuthToken {
  id         String           @id @default(uuid())
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @map("token_hash") @db.VarChar(64)
  userId     String?          @map("user_id")
  email      String?          @db.VarChar(255)
  /// Данные шага: профиль провайдера для `identity_email_link`
  payload    Json?
  expiresAt  DateTime         @map("expires_at")
  consumedAt DateTime?        @map("consumed_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([email, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// ========================
// Membership bridges
// ========================

model Member {
  id                  String              @id @default(uuid())
  userId              String              @map("user_id")
  portalId            String              @map("portal_id")
  entityRecordId      String              @unique @map("entity_record_id")
  membershipNumber    String?             @map("membership_number") @db.VarChar(50)
  isActive            Boolean             @default(true) @map("is_active")
  joinSource          MemberJoinSource    @default(self) @map("join_source")
  registrationLinkId  String?             @map("registration_link_id")
  createdByEmployeeId String?             @map("created_by_employee_id")
  claimedAt           DateTime?           @map("claimed_at")
  /// pending — клуб завёл существующий аккаунт по email, владелец ещё не подтвердил
  consentStatus       MemberConsentStatus @default(confirmed) @map("consent_status")
  consentToken        String?             @unique @map("consent_token") @db.VarChar(128)
  consentRequestedAt  DateTime?           @map("consent_requested_at")
  consentConfirmedAt  DateTime?           @map("consent_confirmed_at")
  /// подпись аккаунта показана этому клубу
  signatureShared     Boolean             @default(false) @map("signature_shared")
  /// Личный лимит отпуска за 30 дней в граммах; пусто — лимит клуба по умолчанию
  monthlyLimitGrams   Decimal?            @map("monthly_limit_grams") @db.Decimal(10, 3)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  portal            Portal                @relation(fields: [portalId], references: [id], onDelete: Cascade)
  profile           EntityRecord          @relation(fields: [entityRecordId], references: [id], onDelete: Cascade)
  registrationLink  RegistrationLink?     @relation(fields: [registrationLinkId], references: [id], onDelete: SetNull)
  createdByEmployee Employee?             @relation("MemberCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  orders            Order[]
  documentShares    MemberDocumentShare[]
  notifications     Notification[]
  counterparties    Counterparty[]

  @@unique([userId, portalId])
  @@unique([portalId, membershipNumber])
  @@index([portalId])
  @@index([userId])
  @@index([isActive])
  @@map("members")
}

model Employee {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  portalId       String    @map("portal_id")
  entityRecordId String    @unique @map("entity_record_id")
  roleId         String    @map("role_id")
  isActive       Boolean   @default(true) @map("is_active")
  invitationId   String?   @map("invitation_id")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  portal     Portal              @relation(fields: [portalId], references: [id], onDelete: Cascade)
  profile    EntityRecord        @relation(fields: [entityRecordId], references: [id], onDelete: Cascade)
  role       PortalRole          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitation EmployeeInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  createdMembers        Member[]               @relation("MemberCreatedBy")
  createdRecords        EntityRecord[]         @relation("RecordCreatedBy")
  presenceSessions      PresenceSession[]      @relation("PresenceEmployee")
  processedOrders       Order[]                @relation("OrderEmployee")
  createdProducts       Product[]              @relation("ProductCreatedBy")
  updatedProducts       Product[]              @relation("ProductUpdatedBy")
  financialTransactions FinancialTransaction[] @relation("TransactionCreatedBy")
  registrationLinks     RegistrationLink[]     @relation("RegistrationLinkCreatedBy")
  sentInvitations       EmployeeInvitation[]   @relation("InvitationInvitedBy")
  comments              EntityComment[]        @relation("CommentAuthor")
  pinnedComments        EntityComment[]        @relation("CommentPinnedBy")
  uiSettings            UiSetting[]
  notifications         Notification[]
  ledgerEntries         LedgerEntry[]          @relation("LedgerEntryCreatedBy")
  voidedLedgerEntries   LedgerEntry[]          @relation("LedgerEntryVoidedBy")
  closedFinancePeriods  FinancePeriod[]        @relation("FinancePeriodClosedBy")
  stockMoves            StockMove[]            @relation("StockMoveEmployee")
  purchases             Purchase[]             @relation("PurchaseEmployee")

  @@unique([userId, portalId])
  @@index([portalId])
  @@index([userId])
  @@index([roleId])
  @@index([isActive])
  @@map("employees")
}

/// Роль сотрудника в клубе: набор кодов прав из каталога (`access/domain/permissions.ts`).
/// Системные (owner, admin, manager, employee) создаются при основании клуба; у owner и admin права
/// не хранятся, а вычисляются — полный доступ. Свои роли клуб заводит с ключом `custom_…`.
model PortalRole {
  id          String   @id @default(uuid())
  portalId    String   @map("portal_id")
  key         String   @db.VarChar(64)
  /// Название своей роли; у системной null — название даёт перевод по ключу
  name        String?  @db.VarChar(120)
  isSystem    Boolean  @default(false) @map("is_system")
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  portal      Portal               @relation(fields: [portalId], references: [id], onDelete: Cascade)
  employees   Employee[]
  invitations EmployeeInvitation[]

  @@unique([portalId, key])
  @@index([portalId])
  @@map("portal_roles")
}

// ========================
// Platform billing
// ========================

model BillingPlan {
  id            String   @id @default(uuid())
  code          String   @unique @db.VarChar(80)
  name          String   @db.VarChar(255)
  priceAmount   Decimal  @map("price_amount") @db.Decimal(12, 2)
  currency      String   @default("EUR") @db.VarChar(3)
  interval      String   @default("month") @db.VarChar(20)
  featuresJson  Json     @map("features_json")
  isActive      Boolean  @default(true) @map("is_active")
  /// Скрытый тариф (trial, тестовый за 5 €) не попадает в публичный каталог сайта,
  /// но его можно выбрать по прямой ссылке ?plan=<code> в CRM.
  isPublic      Boolean  @default(true) @map("is_public")
  /// Цена в Stripe. Сумма, валюта и период кэшируются отсюда при сохранении тарифа.
  stripePriceId String?  @unique @map("stripe_price_id") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions PortalSubscription[]

  @@index([code])
  @@map("billing_plans")
}

model PortalSubscription {
  id                     String             @id @default(uuid())
  portalId               String             @unique @map("portal_id")
  planId                 String             @map("plan_id")
  status                 SubscriptionStatus @default(trialing)
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  graceEndsAt            DateTime?          @map("grace_ends_at")
  /// Конец бесплатного периода; учитывается, пока status = trialing.
  trialEndsAt            DateTime?          @map("trial_ends_at")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  /// Кто ведёт подписку: stripe — статус и период приходят вебхуками; manual — продление
  /// из админки, срок проверяет крон; null — оплаты ещё не было.
  provider               String?            @db.VarChar(50)
  providerCustomerId     String?            @map("provider_customer_id") @db.VarChar(255)
  providerSubscriptionId String?            @unique @map("provider_subscription_id") @db.VarChar(255)
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  portal Portal      @relation(fields: [portalId], references: [id], onDelete: Cascade)
  plan   BillingPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([status])
  @@map("portal_subscriptions")
}

model Payment {
  id          String        @id @default(uuid())
  portalId    String        @map("portal_id")
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("EUR") @db.VarChar(3)
  status      PaymentStatus @default(pending)
  provider    String?       @db.VarChar(50)
  externalId  String?       @map("external_id") @db.VarChar(255)
  paidAt      DateTime?     @map("paid_at")
  /// Оплаченный период
  periodStart DateTime?     @map("period_start")
  periodEnd   DateTime?     @map("period_end")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  portal Portal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  // Якорь идемпотентности вебхуков: повторная доставка того же платежа провайдера
  // упирается в индекс, а не создаёт второе списание. Оба поля nullable, а Postgres
  // считает NULL различными — поэтому ручные платежи (provider = NULL) индекс не
  // ограничивает, и отдельный частичный индекс `WHERE external_id IS NOT NULL` не нужен.
  @@unique([provider, externalId])
  @@index([portalId])
  @@index([status])
  @@map("payments")
}

/// Журнал событий платёжного провайдера — сырой payload и отметка обработки.
/// Платформенный, не портальный: при приёме вебхука портал ещё неизвестен,
/// он выводится из payload на этапе обработки.
model PaymentEvent {
  id       String @id @default(uuid())
  provider String @db.VarChar(50)
  eventId  String @map("event_id") @db.VarChar(255)
  type     String @db.VarChar(100)
  /// Сырое тело вебхука как пришло. При разборе спорных списаний — единственный источник правды.
  payload  Json

  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  failedAt    DateTime? @map("failed_at")
  error       String?   @db.Text
  attempts    Int       @default(0)

  // Первый шаг обработки вебхука: конфликт по этому ключу означает повторную доставку.
  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("payment_events")
}

enum IdempotencyStatus {
  in_progress
  completed
}

/// Ключи идемпотентности для POST-запросов, которые нельзя выполнить дважды.
/// Клиент присылает `Idempotency-Key`, сервер занимает ключ до выполнения и
/// сохраняет ответ после — повтор возвращает сохранённое, а не выполняет заново.
model IdempotencyKey {
  id String @id @default(uuid())

  /// Логический маршрут: "lk.orders.create". Ключи разных операций не пересекаются.
  scope       String @db.VarChar(100)
  /// Принципал: "<portalId>:<principalType>:<membershipId>". Клиентский ключ уникален
  /// только внутри своего владельца — иначе совпадение ключей у двух клубов отдало бы
  /// одному чужой ответ.
  ownerKey    String @map("owner_key") @db.VarChar(200)
  /// Значение заголовка `Idempotency-Key` как прислал клиент.
  key         String @db.VarChar(255)
  /// sha256 канонизированного тела: тот же ключ с другим телом — ошибка клиента, а не повтор.
  requestHash String @map("request_hash") @db.Char(64)

  status     IdempotencyStatus @default(in_progress)
  /// HTTP-статус сохранённого ответа; воспроизводится при повторе.
  statusCode Int?              @map("status_code")
  /// Тело успешного ответа. Ошибки не сохраняются — строка снимается, чтобы ретрай сработал.
  response   Json?

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  /// Горизонт хранения. Протухшая строка не блокирует переиспользование ключа.
  expiresAt   DateTime  @map("expires_at")

  @@unique([scope, ownerKey, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

