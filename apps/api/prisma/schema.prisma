model Stage {
  id                String        @id @default(uuid())
  stageCategoryId   String        @map("stage_category_id")
  name              String        @db.VarChar(255)
  /// переводы системного названия; клуб переименовал стадию — сбрасывается в null
  nameI18n          Json?         @map("name_i18n")
  sortOrder         Int           @default(0) @map("sort_order")
  color             String?       @db.VarChar(32)
  semantic          StageSemantic
  isTerminalSuccess Boolean       @default(false) @map("is_terminal_success")
  isTerminalFailure Boolean       @default(false) @map("is_terminal_failure")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  stageCategory StageCategory  @relation(fields: [stageCategoryId], references: [id], onDelete: Cascade)
  entityRecords EntityRecord[]

  @@index([stageCategoryId])
  @@map("stages")
}

// ========================
// Registration links & invitations
// ========================

model RegistrationLink {
  id                  String               @id @default(uuid())
  portalId            String               @map("portal_id")
  entityDefinitionId  String               @map("entity_definition_id")
  formDefinitionId    String?              @map("form_definition_id")
  token               String               @unique @db.VarChar(64)
  name                String               @db.VarChar(255)
  kind                RegistrationLinkKind @default(public_link)
  isActive            Boolean              @default(true) @map("is_active")
  expiresAt           DateTime?            @map("expires_at")
  maxUses             Int?                 @map("max_uses")
  usesCount           Int                  @default(0) @map("uses_count")
  /// Значения формы, с которыми открывается анкета (личная ссылка из CRM): {email?, fields?}
  prefillJson         Json?                @map("prefill_json")
  /// Отозвана сотрудником — в отличие от просто выключенной (is_active)
  revokedAt           DateTime?            @map("revoked_at")
  createdByEmployeeId String?              @map("created_by_employee_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  portal            Portal           @relation(fields: [portalId], references: [id], onDelete: Cascade)
  entityDefinition  EntityDefinition @relation(fields: [entityDefinitionId], references: [id], onDelete: Cascade)
  formDefinition    FormDefinition?  @relation(fields: [formDefinitionId], references: [id], onDelete: SetNull)
  createdByEmployee Employee?        @relation("RegistrationLinkCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  members           Member[]

  @@index([portalId])
  @@index([token])
  @@map("registration_links")
}

model EmployeeInvitation {
  id                  String           @id @default(uuid())
  portalId            String           @map("portal_id")
  email               String           @db.VarChar(255)
  roleId              String           @map("role_id")
  token               String           @unique @db.VarChar(64)
  status              InvitationStatus @default(pending)
  invitedByEmployeeId String?          @map("invited_by_employee_id")
  expiresAt           DateTime         @map("expires_at")
  acceptedAt          DateTime?        @map("accepted_at")
  acceptedUserId      String?          @map("accepted_user_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  portal            Portal     @relation(fields: [portalId], references: [id], onDelete: Cascade)
  invitedByEmployee Employee?  @relation("InvitationInvitedBy", fields: [invitedByEmployeeId], references: [id], onDelete: SetNull)
  role              PortalRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employees         Employee[]

  @@index([portalId, email])
  @@index([token])
  @@map("employee_invitations")
}

// ========================
// UI settings (portal defaults + per-employee overrides)
// ========================

/// Настройка интерфейса по ключу: клубная (employee_id = null) или личная, поверх клубной.
model UiSetting {
  id         String   @id @default(uuid())
  portalId   String   @map("portal_id")
  /// null — настройка клуба; иначе личная настройка этого сотрудника
  employeeId String?  @map("employee_id")
  /// Что настраивается, например `kanban.order.card-fields`
  key        String   @db.VarChar(120)
  value      Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  portal   Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([portalId, employeeId, key])
  @@index([portalId, key])
  @@map("ui_settings")
}

// ========================
// Reviews (member ratings)
// ========================

model PortalReview {
  id        String   @id @default(uuid())
  portalId  String   @map("portal_id")
  userId    String   @map("user_id")
  score     Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  portal Portal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([portalId, userId])
  @@index([portalId])
  @@map("portal_reviews")
}

model ProductReview {
  id        String   @id @default(uuid())
  portalId  String   @map("portal_id")
  productId String   @map("product_id")
  userId    String   @map("user_id")
  score     Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  portal  Portal  @relation(fields: [portalId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([portalId])
  @@index([productId])
  @@map("product_reviews")
}

// ========================
// Storage / QR / presence
// ========================

model QrCode {
  id             String   @id @default(uuid())
  entityRecordId String   @unique @map("entity_record_id")
  /// Момент выпуска: из него и id сервер считает подпись кода, поэтому перевыпуск гасит прежний код.
  /// Самого кода в БД нет (QrCodesService)
  issuedAt       DateTime @default(now()) @map("issued_at")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  entityRecord EntityRecord @relation(fields: [entityRecordId], references: [id], onDelete: Cascade)

  @@index([entityRecordId])
  @@index([expiresAt])
  @@map("qr_codes")
}

/// Присутствие в клубе по его правилам (TASK-714). Строки нет — значения по умолчанию из
/// presence-settings.ts: Европа/Мадрид, авто-выход в 03:00, без потолка длительности
model PresenceSettings {
  portalId        String   @id @map("portal_id")
  /// IANA, например Europe/Madrid: в нём считается время авто-выхода
  timezone        String   @db.VarChar(64)
  /// Ежедневный авто-выход забытых визитов, HH:MM по часовому поясу клуба
  autoExitTime    String   @map("auto_exit_time") @db.VarChar(5)
  /// Визит длиннее — закрывается сам; пусто — без потолка
  maxSessionHours Int?     @map("max_session_hours")
  updatedAt       DateTime @updatedAt @map("updated_at")

  portal Portal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@map("presence_settings")
}

model PresenceSession {
  id             String    @id @default(uuid())
  entityRecordId String    @map("entity_record_id")
  employeeId     String?   @map("employee_id")
  enteredAt      DateTime  @default(now()) @map("entered_at")
  exitedAt       DateTime? @map("exited_at")
  entryMethod    String    @map("entry_method") @db.VarChar(50)
  exitMethod     String?   @map("exit_method") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  /// Держит entityRecordId, пока сессия открыта, и NULL после закрытия.
  /// Уникальность + «NULL не конфликтует с NULL» в Postgres дают ровно одну
  /// открытую сессию на участника, при любом числе закрытых.
  /// Инвариант: activeEntityRecordId IS NOT NULL <=> exitedAt IS NULL.
  /// Прямое выражение этого правила — частичный уникальный индекс
  /// (WHERE exited_at IS NULL), но Prisma не умеет его в схеме, а добавленный
  /// сырым SQL он сносится при следующем `migrate dev` (prisma/prisma#29220,
  /// открыт, воспроизводится на 7.4.x). Колонка — эквивалент по гарантии,
  /// который переживает генерацию миграций.
  activeEntityRecordId String? @unique @map("active_entity_record_id")

  entityRecord EntityRecord @relation(fields: [entityRecordId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation("PresenceEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([entityRecordId])
  @@index([employeeId])
  @@index([enteredAt])
  @@index([exitedAt])
  @@map("presence_sessions")
}

// ========================
// Catalog
// ========================

model MeasurementUnit {
  id          String   @id @default(uuid())
  portalId    String   @map("portal_id")
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isCustom    Boolean  @default(false) @map("is_custom")
  /// Весовая (граммы, килограммы): при скане товара количество вводят, а не ставят 1 (TASK-807)
  isWeighed   Boolean  @default(false) @map("is_weighed")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  portal   Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  products Product[]

  // Раньше code был уникален глобально: клуб A занимал код, и клуб B не мог завести свой.
  // Плюс запись была открыта админу любого портала — он правил чужой справочник.
  @@unique([portalId, code])
  @@index([portalId])
  @@index([code])
  @@index([isActive])
  @@map("measurement_units")
}

model ProductCategory {
  id          String   @id @default(uuid())
  portalId    String   @map("portal_id")
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  portal   Portal            @relation(fields: [portalId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([portalId, code])
  @@index([portalId])
  @@index([code])
  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("product_categories")
}

model Product {
  id                String            @id @default(uuid())
  portalId          String            @map("portal_id")
  entityRecordId    String            @unique @map("entity_record_id")
  categoryId        String            @map("category_id")
  measurementUnitId String            @map("measurement_unit_id")
  name              String            @db.VarChar(255)
  description       String?           @db.Text
  sku               String?           @db.VarChar(100)
  /// Код для QR-этикетки (TASK-807): короткий, уникальный в клубе, выдаётся при создании
  code              String            @db.VarChar(16)
  /// Штрихкод производителя (EAN/UPC), если на упаковке уже есть свой
  barcode           String?           @db.VarChar(64)
  /// Расходник: не продаётся, списывается по скану (перчатки, краска, пакеты)
  isConsumable      Boolean           @default(false) @map("is_consumable")
  price             Decimal           @db.Decimal(10, 2)
  initialQuantity   Decimal           @map("initial_quantity") @db.Decimal(10, 3)
  currentQuantity   Decimal           @map("current_quantity") @db.Decimal(10, 3)
  minQuantity       Decimal?          @map("min_quantity") @db.Decimal(10, 3)
  imageUrl          String?           @map("image_url") @db.VarChar(500)
  isActive          Boolean           @default(true) @map("is_active")
  isAvailable       Boolean           @default(true) @map("is_available")
  thc               Decimal?          @db.Decimal(5, 2)
  cbd               Decimal?          @db.Decimal(5, 2)
  strain            String?           @db.VarChar(100)
  /// Кому товар виден в кабинете: пусто — всем участникам, иначе тем, у кого клуб отметил хотя бы одну
  audiences         ProductAudience[] @default([])
  /// Сколько граммов лимита участника занимает единица товара; пусто — товар в лимит не входит
  limitGramsPerUnit Decimal?          @map("limit_grams_per_unit") @db.Decimal(10, 3)
  /// Ставка налога (TASK-797); пусто — ставка клуба по умолчанию
  taxRateId         String?           @map("tax_rate_id")
  /// Цена с налогом или без (налог сверху); пусто — как в профиле организации
  priceIncludesTax  Boolean?          @map("price_includes_tax")
  /// Средняя себестоимость единицы без налога (TASK-804); пусто — поставок ещё не было
  averageCost       Decimal?          @map("average_cost") @db.Decimal(10, 4)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  createdBy         String?           @map("created_by")
  updatedBy         String?           @map("updated_by")

  portal            Portal          @relation(fields: [portalId], references: [id], onDelete: Cascade)
  entityRecord      EntityRecord    @relation(fields: [entityRecordId], references: [id], onDelete: Cascade)
  category          ProductCategory @relation(fields: [categoryId], references: [id])
  measurementUnit   MeasurementUnit @relation(fields: [measurementUnitId], references: [id])
  taxRate           TaxRate?        @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  images            ProductImage[]
  orderItems        OrderItem[]
  reviews           ProductReview[]
  stockMoves        StockMove[]
  purchases         Purchase[]
  createdByEmployee Employee?       @relation("ProductCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByEmployee Employee?       @relation("ProductUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([portalId, sku])
  @@unique([portalId, code])
  @@unique([portalId, barcode])
  @@index([portalId])
  @@index([categoryId])
  @@index([measurementUnitId])
  @@index([taxRateId])
  @@index([sku])
  @@index([isActive])
  @@index([isAvailable])
  @@index([name])
  @@map("products")
}

/// Аудитория товара; совпадает с флагами участника is_medical / is_mj / is_recreation, их ставит клуб
enum ProductAudience {
  medical
  mj
  recreation
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  storagePath String   @map("storage_path") @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
  @@map("product_images")
}

// ========================
// Orders & finance
// ========================

model Order {
  id             String    @id @default(uuid())
  portalId       String    @map("portal_id")
  entityRecordId String    @unique @map("entity_record_id")
  memberId       String    @map("member_id")
  employeeId     String?   @map("employee_id")
  orderNumber    String    @map("order_number") @db.VarChar(50)
  paymentStatus  String    @default("pending") @map("payment_status") @db.VarChar(50)
  subtotal       Decimal   @db.Decimal(10, 2)
  discount       Decimal   @default(0) @db.Decimal(10, 2)
  total          Decimal   @db.Decimal(10, 2)
  /// База и налог заказа — суммы снимков строк (TASK-797); пусто — заказ без разбивки
  netTotal       Decimal?  @map("net_total") @db.Decimal(10, 2)
  taxTotal       Decimal?  @map("tax_total") @db.Decimal(10, 2)
  orderedAt      DateTime  @default(now()) @map("ordered_at")
  confirmedAt    DateTime? @map("confirmed_at")
  preparedAt     DateTime? @map("prepared_at")
  readyAt        DateTime? @map("ready_at")
  completedAt    DateTime? @map("completed_at")
  cancelledAt    DateTime? @map("cancelled_at")
  notes          String?   @db.Text
  adminNotes     String?   @map("admin_notes") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  portal       Portal                 @relation(fields: [portalId], references: [id], onDelete: Cascade)
  entityRecord EntityRecord           @relation(fields: [entityRecordId], references: [id], onDelete: Cascade)
  member       Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  employee     Employee?              @relation("OrderEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  transactions FinancialTransaction[]
  stockMoves   StockMove[]

  @@unique([portalId, orderNumber])
  @@index([portalId])
  @@index([memberId])
  @@index([employeeId])
  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([orderedAt])
  @@map("orders")
}

model OrderItem {
  id           String        @id @default(uuid())
  orderId      String        @map("order_id")
  productId    String        @map("product_id")
  quantity     Decimal       @db.Decimal(10, 3)
  unitPrice    Decimal       @map("unit_price") @db.Decimal(10, 2)
  totalPrice   Decimal       @map("total_price") @db.Decimal(10, 2)
  /// подарок: товар списан со склада, но в сумму заказа не входит (total_price = 0)
  isGift       Boolean       @default(false) @map("is_gift")
  /// граммы лимита участника на момент заказа (количество × граммы на единицу); подарок тоже входит
  limitGrams   Decimal       @default(0) @map("limit_grams") @db.Decimal(10, 3)
  /// Снимок налога строки на момент заказа (TASK-797): total_price = net_amount + tax_amount.
  /// Пусто — заказ без разбивки: финансы клуба были выключены
  taxPercent   Decimal?      @map("tax_percent") @db.Decimal(5, 2)
  taxTreatment TaxTreatment? @map("tax_treatment")
  netAmount    Decimal?      @map("net_amount") @db.Decimal(10, 2)
  taxAmount    Decimal?      @map("tax_amount") @db.Decimal(10, 2)
  /// Себестоимость единицы на момент заказа (TASK-804); пусто — поставок не было
  unitCost     Decimal?      @map("unit_cost") @db.Decimal(10, 4)
  notes        String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model FinancialTransaction {
  id              String   @id @default(uuid())
  portalId        String   @map("portal_id")
  orderId         String?  @map("order_id")
  entityRecordId  String?  @map("entity_record_id")
  type            String   @db.VarChar(50)
  direction       String   @db.VarChar(20)
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("EUR") @db.VarChar(3)
  paymentMethod   String?  @map("payment_method") @db.VarChar(50)
  transactionDate DateTime @default(now()) @map("transaction_date")
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String?  @map("created_by")
  description     String?  @db.Text
  notes           String?  @db.Text

  /// Источник проводки — ключ идемпотентности. Например ("order_payment", orderId)
  /// или ("provider_refund", refundId провайдера). У ручных проводок источника нет.
  sourceType String? @map("source_type") @db.VarChar(50)
  sourceId   String? @map("source_id") @db.VarChar(255)

  portal            Portal        @relation(fields: [portalId], references: [id], onDelete: Cascade)
  order             Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  entityRecord      EntityRecord? @relation(fields: [entityRecordId], references: [id], onDelete: SetNull)
  createdByEmployee Employee?     @relation("TransactionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  // Деньги append-only: двойное списание ловится этим индексом, а не сверкой
  // арифметики постфактум. Оба поля nullable, NULL в Postgres различны —
  // ручные проводки индекс не ограничивает.
  @@unique([sourceType, sourceId])
  @@index([portalId])
  @@index([orderId])
  @@index([entityRecordId])
  @@index([type])
  @@index([direction])
  @@index([transactionDate])
  @@index([createdBy])
  @@map("financial_transactions")
}

// ========================
// Domain events (outbox)
// ========================

/// Outbox доменных событий (TASK-780): строка пишется в одной транзакции с изменением, релей
/// раздаёт её потребителям через очередь `domain-events`. Это же — журнал портала.
/// Контракт конверта и payload — пакет `@workspace/domain-events`.
model DomainEvent {
  id            String    @id @default(uuid())
  /// Порядок публикации для релея и журнала (bigserial)
  sequence      BigInt    @unique @default(autoincrement())
  /// Пусто только у событий аккаунта (scope `account`: сессии)
  portalId      String?   @map("portal_id")
  name          String    @db.VarChar(80)
  version       Int       @default(1)
  aggregateKind String    @map("aggregate_kind") @db.VarChar(40)
  aggregateId   String    @map("aggregate_id")
  actorKind     String    @map("actor_kind") @db.VarChar(20)
  actorId       String?   @map("actor_id")
  payload       Json
  occurredAt    DateTime  @map("occurred_at")
  /// Когда релей поставил событие в очередь; NULL — ещё не раздавалось
  dispatchedAt  DateTime? @map("dispatched_at")

  portal     Portal?               @relation(fields: [portalId], references: [id], onDelete: Cascade)
  deliveries DomainEventDelivery[]

  /// Выборка релея: `dispatched_at IS NULL ORDER BY sequence`
  @@index([dispatchedAt, sequence])
  @@index([portalId, occurredAt])
  @@index([aggregateKind, aggregateId])
  @@map("domain_events")
}

/// Доставка события потребителю: один раз на пару (событие, потребитель) — идемпотентность
/// повторов очереди. `deliveredAt` пусто, пока потребитель не отработал без ошибки.
model DomainEventDelivery {
  eventId     String    @map("event_id")
  consumer    String    @db.VarChar(120)
  attempts    Int       @default(0)
  deliveredAt DateTime? @map("delivered_at")
  lastError   String?   @map("last_error") @db.Text
  updatedAt   DateTime  @updatedAt @map("updated_at")

  event DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, consumer])
  @@index([deliveredAt])
  @@map("domain_event_deliveries")
}

// ========================
// Portal modules and data keys
// ========================

/// Подключённые модули портала (TASK-796): строка есть — модуль включён. Что за модули, кому
/// доступны и что делают при включении — каталог в коде (`portal-modules/domain`).
model PortalModule {
  portalId            String   @map("portal_id")
  code                String   @db.VarChar(40)
  enabledAt           DateTime @default(now()) @map("enabled_at")
  enabledByEmployeeId String?  @map("enabled_by_employee_id")

  portal Portal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@id([portalId, code])
  @@map("portal_modules")
}

/// Ключ данных портала (envelope): случайный ключ AES-256 на портал и цель, завёрнутый ключом,
/// выведенным из ENCRYPTION_MASTER_KEY. Ротация — новая версия; шифротекст помнит свою.
model PortalDataKey {
  portalId   String   @map("portal_id")
  purpose    String   @db.VarChar(40)
  version    Int      @default(1)
  wrappedKey String   @map("wrapped_key") @db.Text
  kekVersion Int      @default(1) @map("kek_version")
  createdAt  DateTime @default(now()) @map("created_at")

  portal Portal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@id([portalId, purpose, version])
  @@map("portal_data_keys")
}

// ========================
// Finance: organization
// ========================

/// Форма организации: asociación (клуб), autónomo (мастер или студия ИП), SL, другое.
enum LegalForm {
  association
  self_employed
  limited_company
  other
}

/// Режим IVA: общий, освобождённый (только не облагаемые операции), recargo de equivalencia.
enum VatRegime {
  general
  exempt
  equivalence_surcharge
}

/// Налог на прибыль: IS частично освобождённой ассоциации (art. 9.3 LIS), IS общества, IRPF
/// autónomo — estimación directa simplificada, normal или objetiva (módulos).
enum IncomeTaxRegime {
  corporate_partially_exempt
  corporate
  irpf_direct_simplified
  irpf_direct_normal
  irpf_objective
}

/// Организация портала для учёта и документов (TASK-796). Налоговые настройки — открыто: по ним
/// считаются отчёты; реквизиты (название, NIF, адрес, IBAN, контакты, gestor) — шифром ключа портала.
model OrganizationProfile {
  portalId             String          @id @map("portal_id")
  legalForm            LegalForm       @map("legal_form")
  country              String          @default("ES") @db.VarChar(2)
  currency             String          @default("EUR") @db.VarChar(3)
  vatRegime            VatRegime       @map("vat_regime")
  incomeTaxRegime      IncomeTaxRegime @map("income_tax_regime")
  /// Цены в каталоге — с налогом (по умолчанию) или без: товар и услуга могут переопределить
  pricesIncludeTax     Boolean         @default(true) @map("prices_include_tax")
  fiscalYearStartMonth Int             @default(1) @map("fiscal_year_start_month")
  identity             String          @db.Text
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  updatedByEmployeeId  String?         @map("updated_by_employee_id")

  portal Portal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@map("organization_profiles")
}

/// Как операция относится к налогу: облагается по ставке, освобождена (exenta, art. 20 LIVA)
/// или вне налога (no sujeta: членские взносы ассоциации). В 303 они попадают в разные клетки
enum TaxTreatment {
  taxable
  exempt
  not_subject

  @@map("tax_treatment")
}

/// Ставка налога клуба (TASK-797). Пресет Испании появляется при подключении финансов; подпись
/// пресета переводит CRM по `presetCode`, у своей ставки — `name`. Ставки не удаляются, а
/// архивируются: заказы хранят снимок, товар на архивную ставку не ссылается
model TaxRate {
  id         String       @id @default(uuid())
  portalId   String       @map("portal_id")
  presetCode String?      @map("preset_code") @db.VarChar(40)
  name       String?      @db.VarChar(80)
  /// Процент: 21.00; у exempt и not_subject — 0
  percent    Decimal      @db.Decimal(5, 2)
  treatment  TaxTreatment @default(taxable)
  /// Одна ставка по умолчанию на клуб — меняется одним UPDATE в репозитории
  isDefault  Boolean      @default(false) @map("is_default")
  sortOrder  Int          @default(0) @map("sort_order")
  archivedAt DateTime?    @map("archived_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  portal   Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([portalId, presetCode])
  @@index([portalId])
  @@map("tax_rates")
}

enum NotificationRecipient {
  employee
  member

  @@map("notification_recipient")
}

/// Личное уведомление (TASK-781): сотруднику в CRM или участнику в кабинете. Текст собирает
/// клиент по `type` и `params` на языке получателя, Telegram — сервер по тем же ключам.
/// Источник — событие шины: одно событие даёт адресату одно уведомление (`recipient_key`)
model Notification {
  id            String                @id @default(uuid())
  portalId      String                @map("portal_id")
  recipientKind NotificationRecipient @map("recipient_kind")
  employeeId    String?               @map("employee_id")
  memberId      String?               @map("member_id")
  /// `employee:<id>` или `member:<id>`: уникальность (событие, адресат) без NULL в индексе
  recipientKey  String                @map("recipient_key") @db.VarChar(80)
  type          String                @db.VarChar(64)
  eventId       String                @map("event_id")
  /// О чём уведомление: куда ведёт нажатие (заказ, участник…)
  subjectKind   String                @map("subject_kind") @db.VarChar(32)
  subjectId     String                @map("subject_id")
  /// Параметры текста: номер заказа, стадия; без персональных данных
  params        Json                  @default("{}")
  readAt        DateTime?             @map("read_at")
  createdAt     DateTime              @default(now()) @map("created_at")

  portal   Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  member   Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, recipientKey])
  @@index([portalId, recipientKey, createdAt])
  @@map("notifications")
}

/// Канал уведомлений аккаунта вне приложения (`telegram`); строки нет — канал включён
model NotificationPreference {
  userId    String   @map("user_id")
  channel   String   @db.VarChar(32)
  enabled   Boolean
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channel])
  @@map("notification_preferences")
}

/// Комментарий сотрудника (TASK-782): заметка в таймлайне карточки (`member`, `order`, `employee`,
/// `product`) или пост в ленте клуба (`portal`, TASK-808). Участнику не виден. Удаление мягкое:
/// таймлайн показывает «комментарий удалён», а не дыру
model EntityComment {
  id                 String    @id @default(uuid())
  portalId           String    @map("portal_id")
  subjectKind        String    @map("subject_kind") @db.VarChar(32)
  subjectId          String    @map("subject_id")
  authorEmployeeId   String?   @map("author_employee_id")
  body               String    @db.Text
  pinnedAt           DateTime? @map("pinned_at")
  pinnedByEmployeeId String?   @map("pinned_by_employee_id")
  editedAt           DateTime? @map("edited_at")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  portal   Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  author   Employee? @relation("CommentAuthor", fields: [authorEmployeeId], references: [id], onDelete: SetNull)
  pinnedBy Employee? @relation("CommentPinnedBy", fields: [pinnedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([portalId, subjectKind, subjectId, createdAt])
  @@index([portalId, createdAt])
  @@map("entity_comments")
}

// ========================
// Ledger (TASK-798)
// ========================

/// Направление проводки: доход, расход или перевод между своими счетами (касса → банк)
enum LedgerDirection {
  income
  expense
  transfer

  @@map("ledger_direction")
}

/// Проводка в учёте или отменена в открытом месяце; закрытый месяц исправляется сторно
enum LedgerEntryStatus {
  posted
  void

  @@map("ledger_entry_status")
}

/// Счёт, через который прошли деньги: касса клуба, банковский счёт, карта
enum FinanceAccount {
  cash
  bank
  card

  @@map("finance_account")
}

/// Документ проводки: фактура полученная (расход), выданная (доход), чек или без документа
enum LedgerDocumentType {
  invoice_received
  invoice_issued
  receipt
  none

  @@map("ledger_document_type")
}

/// Кто контрагент: поставщик, клиент, участник клуба, сотрудник, госорган (AEAT, Seguridad Social)
enum CounterpartyKind {
  supplier
  customer
  member
  employee
  authority

  @@map("counterparty_kind")
}

/// Статья доходов или расходов клуба. Пресет (клуб или студия) появляется при подключении
/// финансов: подпись пресета переводит CRM по `code`, у своей статьи — `name`. По `code` импорт
/// таблицей находит статью. Статьи не удаляются, а архивируются: на них ссылаются проводки
model FinanceCategory {
  id           String          @id @default(uuid())
  portalId     String          @map("portal_id")
  code         String          @db.VarChar(40)
  name         String?         @db.VarChar(80)
  /// income или expense; переводы статьи не имеют
  direction    LedgerDirection
  /// Счёт плана PGC (упрощённо): 600 закупки, 621 аренда, 705 услуги, 720 взносы…
  pgcAccount   String?         @map("pgc_account") @db.VarChar(10)
  /// Налог проводок статьи по умолчанию: взносы ассоциации — not_subject; пусто — ставка клуба
  taxTreatment TaxTreatment?   @map("tax_treatment")
  isPreset     Boolean         @default(false) @map("is_preset")
  sortOrder    Int             @default(0) @map("sort_order")
  archivedAt   DateTime?       @map("archived_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  portal  Portal        @relation(fields: [portalId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@unique([portalId, code])
  @@index([portalId, direction])
  @@map("finance_categories")
}

/// Контрагент проводок. Имя, NIF, страна, заметки — одним шифром ключа портала (`details`);
/// дубль по NIF или имени находят слепые индексы (HMAC ключом портала), не открытые значения.
/// Участник клуба — ссылкой на участника: имя берётся из его карточки, своё не хранится
model Counterparty {
  id         String           @id @default(uuid())
  portalId   String           @map("portal_id")
  kind       CounterpartyKind
  memberId   String?          @map("member_id")
  details    String?          @db.Text
  nifIndex   String?          @map("nif_index") @db.VarChar(64)
  nameIndex  String?          @map("name_index") @db.VarChar(64)
  archivedAt DateTime?        @map("archived_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  portal    Portal        @relation(fields: [portalId], references: [id], onDelete: Cascade)
  member    Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  entries   LedgerEntry[]
  purchases Purchase[]

  @@unique([portalId, memberId])
  @@unique([portalId, nifIndex])
  @@index([portalId, nameIndex])
  @@map("counterparties")
}

/// Проводка учёта (заменяет `financial_transactions`). Открыто только то, по чему выбирают:
/// портал, дата, статья, направление, счёт, источник, статус. Суммы (строки налога, удержание),
/// описание, заметки, номер и даты документа — шифр ключа портала в `payload`.
/// Источник — ключ идемпотентности: оплата заказа (`order_sale`, `<orderId>#<n>`), строка импорта
/// (`import`, `<хеш файла>:<строка>`), сторно (`reversal`, id отменённой проводки). Сторно —
/// отдельная проводка с обратными суммами в открытом месяце
model LedgerEntry {
  id             String             @id @default(uuid())
  portalId       String             @map("portal_id")
  direction      LedgerDirection
  status         LedgerEntryStatus  @default(posted)
  /// Дата операции (fecha de operación); месяц проводки — её месяц
  occurredOn     DateTime           @map("occurred_on") @db.Date
  categoryId     String?            @map("category_id")
  counterpartyId String?            @map("counterparty_id")
  account        FinanceAccount
  /// Перевод: счёт, на который пришли деньги
  toAccount      FinanceAccount?    @map("to_account")
  currency       String             @default("EUR") @db.VarChar(3)
  documentType   LedgerDocumentType @default(none) @map("document_type")
  /// Слепой индекс номера документа: тот же контрагент и номер — вероятный дубль
  documentIndex  String?            @map("document_index") @db.VarChar(64)
  payload        String             @db.Text
  /// Вложение (чек, фактура) в private storage, зашифровано ключом портала
  attachmentPath String?            @map("attachment_path") @db.VarChar(255)
  sourceType     String             @map("source_type") @db.VarChar(20)
  sourceId       String?            @map("source_id") @db.VarChar(255)
  reversalOfId   String?            @unique @map("reversal_of_id")
  createdById    String?            @map("created_by_id")
  voidedAt       DateTime?          @map("voided_at")
  voidedById     String?            @map("voided_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  portal       Portal           @relation(fields: [portalId], references: [id], onDelete: Cascade)
  category     FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  counterparty Counterparty?    @relation(fields: [counterpartyId], references: [id], onDelete: NoAction)
  reversalOf   LedgerEntry?     @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: NoAction)
  reversal     LedgerEntry?     @relation("LedgerReversal")
  createdBy    Employee?        @relation("LedgerEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy     Employee?        @relation("LedgerEntryVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  purchase     Purchase?

  @@unique([portalId, sourceType, sourceId])
  @@index([portalId, occurredOn])
  @@index([portalId, categoryId])
  @@index([portalId, counterpartyId])
  @@index([portalId, documentIndex])
  @@map("ledger_entries")
}

/// Месяц учёта клуба. Строки нет — месяц открыт. Закрытый месяц замораживает проводки с датой
/// в нём: исправление — сторно в открытом месяце
model FinancePeriod {
  id         String    @id @default(uuid())
  portalId   String    @map("portal_id")
  year       Int
  month      Int
  closedAt   DateTime? @map("closed_at")
  closedById String?   @map("closed_by_id")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  portal   Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  closedBy Employee? @relation("FinancePeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([portalId, year, month])
  @@map("finance_periods")
}

// ========================
// Stock moves and cost (TASK-804)
// ========================

/// Почему остаток изменился: поставка, заказ забрал или вернул, списание руками (брак, пересчёт,
/// подарок) или первый остаток при заведении товара
enum StockMoveReason {
  purchase
  order_placed
  order_cancelled
  write_off
  recount
  gift
  initial

  @@map("stock_move_reason")
}

/// Движение склада: сколько пришло (плюс) или ушло (минус) и по какой себестоимости единицы.
/// Поставка — приход с ценой закупки; списание и продажа — по средней себестоимости товара на тот
/// момент. Журнал нужен для маржи и для инвентаря (Ley 1/2002: инвентарь имущества ассоциации)
model StockMove {
  id           String          @id @default(uuid())
  portalId     String          @map("portal_id")
  productId    String          @map("product_id")
  reason       StockMoveReason
  /// Количество в единицах товара: приход со знаком плюс, расход — минус
  quantity     Decimal         @db.Decimal(10, 3)
  /// Себестоимость единицы в евро на момент движения
  unitCost     Decimal         @map("unit_cost") @db.Decimal(10, 4)
  /// Остаток после движения — так журнал читается без пересчёта
  balanceAfter Decimal         @map("balance_after") @db.Decimal(10, 3)
  orderId      String?         @map("order_id")
  purchaseId   String?         @map("purchase_id")
  /// Причина списания или пересчёта словами
  note         String?         @db.VarChar(500)
  employeeId   String?         @map("employee_id")
  occurredAt   DateTime        @default(now()) @map("occurred_at")

  portal   Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  employee Employee? @relation("StockMoveEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([portalId, productId, occurredAt])
  @@index([portalId, occurredAt])
  @@map("stock_moves")
}

/// Поставка товара: приход на склад и расход в учёте одной транзакцией. Цена за единицу —
/// база без IVA; себестоимость товара после поставки — средневзвешенная
model Purchase {
  id             String   @id @default(uuid())
  portalId       String   @map("portal_id")
  productId      String   @map("product_id")
  quantity       Decimal  @db.Decimal(10, 3)
  /// Цена закупки единицы без налога, евро
  unitCost       Decimal  @map("unit_cost") @db.Decimal(10, 4)
  /// Проводка расхода в реестре (пусто — финансы были выключены)
  ledgerEntryId  String?  @unique @map("ledger_entry_id")
  counterpartyId String?  @map("counterparty_id")
  receivedOn     DateTime @map("received_on") @db.Date
  employeeId     String?  @map("employee_id")
  createdAt      DateTime @default(now()) @map("created_at")

  portal       Portal        @relation(fields: [portalId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  ledgerEntry  LedgerEntry?  @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  employee     Employee?     @relation("PurchaseEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  moves        StockMove[]

  @@index([portalId, receivedOn])
  @@index([portalId, productId])
  @@map("purchases")
}
