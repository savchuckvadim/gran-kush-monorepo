// ========================
// Entity-first CRM core
// ========================

model EntityDefinition {
  id                    String   @id @default(uuid())
  portalId              String   @map("portal_id")
  code                  String   @db.VarChar(80)
  name                  String   @db.VarChar(255)
  icon                  String?  @db.VarChar(80)
  color                 String?  @db.VarChar(32)
  isSystem              Boolean  @default(false) @map("is_system")
  isActive              Boolean  @default(true) @map("is_active")
  applicablePortalTypes Json?    @map("applicable_portal_types")
  globalTemplateId      String?  @map("global_template_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  portal            Portal                @relation(fields: [portalId], references: [id], onDelete: Cascade)
  globalTemplate    GlobalEntityTemplate? @relation(fields: [globalTemplateId], references: [id], onDelete: SetNull)
  records           EntityRecord[]
  fieldDefinitions  FieldDefinition[]
  relationSources   FieldDefinition[]     @relation("FieldRelationTarget")
  formDefinitions   FormDefinition[]
  statusSets        StatusSet[]
  stageCategories   StageCategory[]
  registrationLinks RegistrationLink[]

  @@unique([portalId, code])
  @@index([portalId])
  @@index([globalTemplateId])
  @@map("entity_definitions")
}

model EntityRecord {
  id                  String   @id @default(uuid())
  portalId            String   @map("portal_id")
  entityDefinitionId  String   @map("entity_definition_id")
  statusItemId        String?  @map("status_item_id")
  stageId             String?  @map("stage_id")
  isActive            Boolean  @default(true) @map("is_active")
  /// Место карточки в колонке канбана: меньше — выше. По умолчанию -время создания в мс, поэтому
  /// новая запись встаёт наверх своей стадии без отдельного запроса (records/domain/stage-position.ts).
  stagePosition       Float    @default(dbgenerated("(- (EXTRACT(epoch FROM now()) * (1000)::numeric))")) @map("stage_position")
  createdByEmployeeId String?  @map("created_by_employee_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  portal            Portal           @relation(fields: [portalId], references: [id], onDelete: Cascade)
  entityDefinition  EntityDefinition @relation(fields: [entityDefinitionId], references: [id], onDelete: Cascade)
  statusItem        StatusItem?      @relation(fields: [statusItemId], references: [id], onDelete: SetNull)
  stage             Stage?           @relation(fields: [stageId], references: [id], onDelete: SetNull)
  createdByEmployee Employee?        @relation("RecordCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  fieldValues           FieldValue[]
  member                Member?
  employee              Employee?
  order                 Order?
  product               Product?
  qrCode                QrCode?
  presenceSessions      PresenceSession[]
  financialTransactions FinancialTransaction[]
  relationsAsSource     RecordRelation[]       @relation("RelationSource")
  relationsAsTarget     RecordRelation[]       @relation("RelationTarget")

  @@index([portalId, entityDefinitionId])
  @@index([statusItemId])
  @@index([stageId, stagePosition])
  @@map("entity_records")
}

model StatusSet {
  id                 String   @id @default(uuid())
